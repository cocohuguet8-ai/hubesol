---
const { tense, data } = Astro.props;
const uid = 'gf';
---
{data && (
  <section class="gapfill" id={uid} aria-label="Gap-fill practice" data-tense={tense}>
    <h3>✏️ Practice: {data.title}</h3>
    <p class="practice-sub">{data.subtitle}</p>

    <div id={`${uid}-quizArea`}>
      <div class="practice-progress-row">
        <span id={`${uid}-progressText`}>Question 1 of {data.questions.length}</span>
        <span id={`${uid}-scoreText`}>Score: 0</span>
      </div>
      <div class="practice-progress-track"><div class="practice-progress-fill" id={`${uid}-progressFill`} style="width:0%"></div></div>

      <div class="practice-card">
        <div class="practice-use-tag" id={`${uid}-useTag`}></div>
        <p class="gapfill-sentence" id={`${uid}-sentenceRow`}></p>
        <div class="practice-actions">
          <button type="button" class="practice-btn-primary" id={`${uid}-checkBtn`}>Check</button>
          <button type="button" class="practice-btn-secondary" id={`${uid}-nextBtn`} style="display:none;">Next →</button>
        </div>
        <div class="practice-feedback" id={`${uid}-feedback`}></div>
      </div>
    </div>

    <div class="practice-score-screen" id={`${uid}-scoreScreen`}>
      <div class="practice-card">
        <div class="practice-use-tag">Result</div>
        <div class="practice-score-big" id={`${uid}-finalScore`}>0/{data.questions.length}</div>
        <div class="practice-score-label" id={`${uid}-finalLabel`}>Review your answers:</div>
        <div id={`${uid}-reviewList`}></div>
        <div class="practice-restart-row">
          <button type="button" class="practice-btn-primary" id={`${uid}-restartBtn`}>Try again</button>
        </div>
      </div>
    </div>

    <script type="application/json" id={`${uid}-data`} set:html={JSON.stringify({ tense, questions: data.questions })} />
  </section>
)}

<script>
  function initGapFill(root) {
    const uid = 'gf';
    const dataEl = document.getElementById(`${uid}-data`);
    if (!dataEl) return;
    const payload = JSON.parse(dataEl.textContent);
    const tense = payload.tense;
    const questions = payload.questions;

    let idx = 0, score = 0, answered = false;
    let results = [];

    const progressText = document.getElementById(`${uid}-progressText`);
    const scoreText = document.getElementById(`${uid}-scoreText`);
    const progressFill = document.getElementById(`${uid}-progressFill`);
    const useTag = document.getElementById(`${uid}-useTag`);
    const sentenceRow = document.getElementById(`${uid}-sentenceRow`);
    const checkBtn = document.getElementById(`${uid}-checkBtn`);
    const nextBtn = document.getElementById(`${uid}-nextBtn`);
    const feedback = document.getElementById(`${uid}-feedback`);
    const quizArea = document.getElementById(`${uid}-quizArea`);
    const scoreScreen = document.getElementById(`${uid}-scoreScreen`);
    const restartBtn = document.getElementById(`${uid}-restartBtn`);

    // Normalize curly/smart apostrophes to a straight one, and collapse
    // whitespace, before any comparison — phone keyboards and autocorrect
    // often substitute the curly form, and contractions like "didn't"
    // contain one. Ported verbatim from the approved prototypes.
    function normalize(s) {
      return s.toLowerCase().trim().replace(/\s+/g, ' ').replace(/[‘’]/g, "'");
    }

    // Full forms ("does not") are as correct as contractions ("doesn't").
    const CONTRACTIONS = {"don't":"do not","doesn't":"does not","didn't":"did not","haven't":"have not","hasn't":"has not","hadn't":"had not","won't":"will not","wouldn't":"would not","wasn't":"was not","weren't":"were not","isn't":"is not","aren't":"are not","can't":"cannot","couldn't":"could not","shouldn't":"should not","mustn't":"must not"};
    function expandContractions(s) {
      return normalize(s).split(' ').map((w) => CONTRACTIONS[w] || w).join(' ').replace(/\bcan not\b/g, 'cannot');
    }
    function matchesAnswers(raw, answers) {
      const n = normalize(raw);
      if (answers.indexOf(n) !== -1) return 'exact';
      const e = expandContractions(raw);
      return answers.some((a) => expandContractions(a) === e) ? 'full-form' : '';
    }

    const PAST_REGULAR_TAIL = /ed$/;

    // ---- past-simple diagnose() — ported verbatim from gap-fill-past-simple.html ----
    function diagnosePastSimple(rawText, q) {
      const u = normalize(rawText);
      const c = normalize(q.display);
      if (!u) return "You left it blank — even a guess helps you learn the pattern.";
      const uWords = u.split(' ').filter(Boolean);
      const cWords = c.split(' ').filter(Boolean);

      if (c === 'did') {
        if (u === 'do' || u === 'does') return "Past simple questions always use <b>did</b>, not do/does.";
        if (u === 'was' || u === 'were') return "This needs the auxiliary <b>did</b>, not the verb \"to be\".";
        return "This needs the question auxiliary <b>did</b>.";
      }
      if (cWords[0] === "didn't") {
        const negIssues = [];
        if (u.indexOf("don't") === 0 || u.indexOf('dont') === 0) negIssues.push("Wrong tense: the past negative is <b>didn't</b>, not don't.");
        else if (u.indexOf("doesn't") === 0 || u.indexOf('doesnt') === 0) negIssues.push("Wrong tense: the past negative is <b>didn't</b>, not doesn't.");
        else if (uWords.indexOf('did') === -1 && uWords.indexOf("didn't") === -1) negIssues.push("Don't forget <b>didn't</b> before the verb.");
        const negLast = uWords[uWords.length - 1] || '';
        const cNegLast = cWords[cWords.length - 1] || '';
        if (negLast !== cNegLast) {
          negIssues.push("After \"didn't\", the verb goes back to its base form — check the verb itself.");
        }
        if (negIssues.length === 0) return "Check the negative form — it should be \"" + q.display + "\".";
        return negIssues.join(' ');
      }

      const issues = [];
      if (uWords[0] === 'did') {
        issues.push("Don't add \"did\" here — in an affirmative sentence the past verb itself carries the tense: \"" + q.display + "\".");
      }
      const uLast = uWords[uWords.length - 1] || '';
      if (uLast !== c) {
        if (!PAST_REGULAR_TAIL.test(uLast) && PAST_REGULAR_TAIL.test(c)) {
          issues.push("This is a regular verb in the past — check the -ed ending and its spelling.");
        } else {
          issues.push("Check the verb form — it should be \"" + q.display + "\".");
        }
      }
      if (issues.length === 0) return "Check the verb form — it should be \"" + q.display + "\".";
      return issues.join(' ');
    }

    // ---- past-perfect diagnose() — ported verbatim from gap-fill-past-perfect-simple.html ----
    function diagnosePastPerfect(rawText, q) {
      const u = normalize(rawText);
      const c = normalize(q.display);
      if (!u) return "You left it blank — even a guess helps you learn the pattern.";
      const uWords = u.split(' ').filter(Boolean);
      const cWords = c.split(' ').filter(Boolean);

      if (c === 'had') {
        if (u === 'has' || u === 'have') return "This needs the past auxiliary <b>had</b>, not has/have.";
        if (u === 'was' || u === 'were' || u === 'did') return "This needs the auxiliary <b>had</b> for past perfect.";
        return "This needs the question auxiliary <b>had</b>.";
      }
      if (cWords[0] === "hadn't") {
        const negIssues = [];
        if (u.indexOf("didn't") === 0 || u.indexOf('didnt') === 0) negIssues.push("Wrong tense: the past perfect negative is <b>hadn't</b>, not didn't.");
        else if (u.indexOf("haven't") === 0 || u.indexOf('havent') === 0 || u.indexOf("hasn't") === 0 || u.indexOf('hasnt') === 0) negIssues.push("Wrong auxiliary: for an earlier past action, use <b>hadn't</b>, not haven't/hasn't.");
        else if (uWords.indexOf('had') === -1 && uWords.indexOf("hadn't") === -1) negIssues.push("Don't forget <b>hadn't</b> before the past participle.");
        const negLast = uWords[uWords.length - 1] || '';
        const cNegLast = cWords[cWords.length - 1] || '';
        if (negLast !== cNegLast) {
          if (q.commonError && negLast === q.commonError) negIssues.push("Past perfect needs the past participle here, not the past simple form — \"" + cNegLast + "\", not \"" + q.commonError + "\".");
          else if (!PAST_REGULAR_TAIL.test(negLast) && PAST_REGULAR_TAIL.test(cNegLast)) negIssues.push("This is a regular verb — check the -ed ending on the past participle.");
          else negIssues.push("Check the spelling of the past participle — it should be \"" + cNegLast + "\".");
        }
        if (negIssues.length === 0) return "Check the negative form — it should be \"" + q.display + "\".";
        return negIssues.join(' ');
      }

      const issues = [];
      if (uWords[0] === 'has' || uWords[0] === 'have') {
        issues.push("Wrong auxiliary: an action before another past action needs <b>had</b>, not has/have.");
      } else if (cWords[0] === 'had' && uWords.indexOf('had') === -1 && uWords.indexOf("'d") === -1 && uWords.indexOf('d') === -1) {
        issues.push("Don't forget <b>had</b> before the past participle.");
      }
      const uLast = uWords[uWords.length - 1] || '';
      const cLast = cWords[cWords.length - 1] || '';
      if (uLast !== cLast) {
        if (q.commonError && uLast === q.commonError) {
          issues.push("Past perfect needs the past participle, not the past simple form — \"" + cLast + "\", not \"" + q.commonError + "\".");
        } else if (!PAST_REGULAR_TAIL.test(uLast) && PAST_REGULAR_TAIL.test(cLast)) {
          issues.push("This is a regular verb — check the -ed ending on the past participle.");
        } else {
          issues.push("Check the spelling of the past participle — it should be \"" + cLast + "\".");
        }
      }
      if (issues.length === 0) return "Check the verb form — it should be \"" + q.display + "\".";
      return issues.join(' ');
    }

    // ---- present-perfect diagnose() — ported verbatim from gap-fill-present-perfect.html ----
    const PP_AUX_SWAP = { "have": "has", "has": "have", "haven't": "hasn't", "hasn't": "haven't" };
    function ppParseAux(tokens) {
      if (tokens.length === 0) return { aux: null, rest: '' };
      const t0 = tokens[0];
      if (t0 === "haven't" || t0 === "havent") return { aux: "haven't", rest: tokens.slice(1).join(' ') };
      if (t0 === "hasn't" || t0 === "hasnt") return { aux: "hasn't", rest: tokens.slice(1).join(' ') };
      if (t0 === "'ve" || t0 === "ve") return { aux: "have", rest: tokens.slice(1).join(' ') };
      if (t0 === "'s" || t0 === "s") return { aux: "has", rest: tokens.slice(1).join(' ') };
      if (t0 === "have") {
        if (tokens[1] === "not") return { aux: "haven't", rest: tokens.slice(2).join(' ') };
        return { aux: "have", rest: tokens.slice(1).join(' ') };
      }
      if (t0 === "has") {
        if (tokens[1] === "not") return { aux: "hasn't", rest: tokens.slice(2).join(' ') };
        return { aux: "has", rest: tokens.slice(1).join(' ') };
      }
      return { aux: null, rest: tokens.join(' ') };
    }
    function diagnosePresentPerfect(rawText, q) {
      const norm = normalize(rawText);
      const rawTokens = norm.split(' ').filter(Boolean);
      const correctTokens = normalize(q.display).split(' ').filter(Boolean);
      if (rawTokens.length === 0) return "You left it blank — even a guess helps you learn the pattern.";
      const g = ppParseAux(rawTokens);
      const c = ppParseAux(correctTokens);

      const issues = [];
      if (!g.aux) {
        issues.push("Don't forget the auxiliary (<b>have</b>/<b>has</b>) — without it, this isn't the present perfect.");
      } else if (g.aux !== c.aux) {
        if (PP_AUX_SWAP[g.aux] === c.aux) {
          if (g.aux === "have" || g.aux === "haven't") {
            issues.push("Subject-verb agreement: with <b>he, she, it</b> the auxiliary is <b>has</b>, not have.");
          } else {
            issues.push("Subject-verb agreement: with <b>I, you, we, they</b> the auxiliary is <b>have</b>, not has.");
          }
        } else {
          issues.push("Check the auxiliary — it should be \"" + c.aux + "\".");
        }
      }
      if (g.rest !== c.rest && c.rest) {
        issues.push("Check the verb after the auxiliary — here it should be \"" + c.rest + "\".");
      }
      return issues.join(' ');
    }

    // ---- present-continuous diagnose() — ported verbatim from gap-fill-present-continuous.html ----
    const PC_AUX_WORDS = ["am", "is", "are", "isn't", "aren't"];
    const PC_AUX_SWAP_PAIRS = [["is", "are"], ["is", "am"], ["are", "am"], ["isn't", "aren't"]];
    function pcParseAux(rawWords) {
      for (let i = 0; i < rawWords.length; i++) {
        const w = rawWords[i].toLowerCase();
        if (PC_AUX_WORDS.indexOf(w) !== -1) {
          return { aux: w, rest: rawWords.slice(0, i).concat(rawWords.slice(i + 1)).join(' ').toLowerCase() };
        }
      }
      return { aux: null, rest: rawWords.join(' ').toLowerCase() };
    }
    function pcAuxSwapMatches(a, b) {
      for (let i = 0; i < PC_AUX_SWAP_PAIRS.length; i++) {
        const p = PC_AUX_SWAP_PAIRS[i];
        if ((p[0] === a && p[1] === b) || (p[1] === a && p[0] === b)) return true;
      }
      return false;
    }
    function diagnosePresentContinuous(rawText, q) {
      const userText = rawText.trim();
      const correctText = q.display;
      const userWords = userText.trim().split(/\s+/).filter(Boolean);
      if (userWords.length === 0) return "You left it blank — present continuous needs am/is/are plus the -ing form.";
      if (q.kind === 'blank-only') {
        const u = userText.trim().toLowerCase();
        const c = correctText.toLowerCase();
        if (u.slice(-3) !== 'ing' && c.slice(-3) === 'ing') return "This needs the -ing form.";
        return "Check the spelling of the -ing form — it should be \"" + correctText + "\".";
      }
      const correctWords = correctText.split(/\s+/);
      const u2 = pcParseAux(userWords);
      const c2 = pcParseAux(correctWords);

      const issues = [];
      if (!u2.aux) {
        issues.push("Don't forget the auxiliary (" + c2.aux + ") before the -ing form.");
      } else if (u2.aux !== c2.aux) {
        if (pcAuxSwapMatches(u2.aux, c2.aux)) {
          issues.push("Subject-verb agreement: the auxiliary should be \"" + c2.aux + "\", not \"" + u2.aux + "\".");
        } else {
          issues.push("Check the auxiliary — it should be \"" + c2.aux + "\".");
        }
      }
      if (u2.rest !== c2.rest && c2.rest) {
        if (u2.rest.slice(-3) !== 'ing' && c2.rest.slice(-3) === 'ing') {
          issues.push("This needs the -ing form.");
        } else {
          issues.push("Check the spelling of the -ing form — it should be \"" + c2.rest + "\".");
        }
      }
      if (issues.length === 0) return "Check the verb form — it should be \"" + correctText + "\".";
      return issues.join(' ');
    }

    // ---- article diagnosis (a/an vs one) ----
    function diagnoseArticle(rawText, correctText) {
      const u = rawText.toLowerCase().trim().replace(/\s+/g, ' ');
      const c = correctText.toLowerCase().trim();
      if (!u) return "You left it blank — even a guess helps you learn the pattern.";
      if ((c === 'a' || c === 'an') && (u === 'a' || u === 'an'))
        return "Use <b>a</b> before a consonant <i>sound</i> and <b>an</b> before a vowel <i>sound</i> — the sound matters, not the letter.";
      if ((c === 'a' || c === 'an') && u === 'one')
        return "Jobs and first mentions take <b>a/an</b>. Use <b>one</b> only when the number matters.";
      if (c === 'one' && (u === 'a' || u === 'an'))
        return "Here the number matters (or it is a fixed phrase, or it replaces a noun), so use <b>one</b>.";
      return "Check your answer — it should be \"" + correctText + "\".";
    }

    function diagnose(rawText, q) {
      if (tense === 'a-an-vs-one') return diagnoseArticle(rawText, q.display);
      if (tense === 'past-simple') return diagnosePastSimple(rawText, q);
      if (tense === 'past-perfect') return diagnosePastPerfect(rawText, q);
      if (tense === 'present-perfect') return diagnosePresentPerfect(rawText, q);
      if (tense === 'present-continuous') return diagnosePresentContinuous(rawText, q);
      return "Check the verb form — it should be \"" + q.display + "\".";
    }

    function startQuiz() {
      idx = 0; score = 0; answered = false; results = [];
      quizArea.style.display = '';
      scoreScreen.classList.remove('show');
      render();
    }

    function render() {
      const q = questions[idx];
      useTag.textContent = q.use;
      progressText.textContent = 'Question ' + (idx + 1) + ' of ' + questions.length;
      scoreText.textContent = 'Score: ' + score;
      progressFill.style.width = ((idx / questions.length) * 100) + '%';

      sentenceRow.innerHTML = '';
      if (q.before) {
        const b = document.createElement('span');
        b.textContent = q.before + ' ';
        sentenceRow.appendChild(b);
      }
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'gapfill-input';
      input.id = `${uid}-blankInput`;
      input.autocomplete = 'off';
      input.spellcheck = false;
      sentenceRow.appendChild(input);

      const hint = document.createElement('span');
      hint.className = 'gapfill-hint';
      hint.textContent = q.hint;
      sentenceRow.appendChild(hint);

      const a = document.createElement('span');
      a.textContent = ' ' + q.after;
      sentenceRow.appendChild(a);

      checkBtn.style.display = '';
      checkBtn.disabled = false;
      nextBtn.style.display = 'none';
      feedback.className = 'practice-feedback';
      feedback.textContent = '';
      answered = false;

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (!answered) checkAnswer();
          else goNext();
        }
      });
      input.focus();
    }

    function checkAnswer() {
      if (answered) return;
      answered = true;
      const q = questions[idx];
      const input = document.getElementById(`${uid}-blankInput`);
      const raw = input.value;
      const norm = normalize(raw);
      const matchKind = matchesAnswers(raw, q.answers);
      const isCorrect = !!matchKind;

      input.disabled = true;
      input.classList.add(isCorrect ? 'correct' : 'wrong');

      if (isCorrect) {
        feedback.classList.add('show', 'ok');
        feedback.innerHTML = '<b>Correct.</b> ' + (matchKind === 'full-form' ? 'Tip: in speech and informal writing we usually say "' + q.display + '". ' : '') + q.explain;
      } else {
        const specific = diagnose(raw, q);
        feedback.classList.add('show', 'bad');
        feedback.innerHTML = '<b>Not quite — the correct form is "' + q.display + '".</b> '
          + (specific ? specific + ' ' : '')
          + q.explain;
      }

      if (isCorrect) score++;
      results.push({ before: q.before, after: q.after, display: q.display, given: raw, correct: isCorrect });

      checkBtn.style.display = 'none';
      nextBtn.style.display = '';
      nextBtn.focus();
      scoreText.textContent = 'Score: ' + score;
    }

    function goNext() {
      idx++;
      if (idx >= questions.length) {
        showScore();
      } else {
        render();
      }
    }

    function showScore() {
      quizArea.style.display = 'none';
      scoreScreen.classList.add('show');
      progressFill.style.width = '100%';
      document.getElementById(`${uid}-finalScore`).textContent = score + '/' + questions.length;
      const label = document.getElementById(`${uid}-finalLabel`);
      if (score === questions.length) label.textContent = 'Perfect score! Review your answers:';
      else if (score >= questions.length - 3) label.textContent = 'Well done. Review your answers:';
      else label.textContent = 'Review your answers:';

      const list = document.getElementById(`${uid}-reviewList`);
      list.innerHTML = '';
      results.forEach((r) => {
        const row = document.createElement('div');
        row.className = 'practice-review-item';
        const sent = document.createElement('span');
        sent.className = 'rsent';
        sent.textContent = (r.before ? r.before + ' ' : '') + r.display + ' ' + r.after;
        const mark = document.createElement('span');
        mark.className = 'rmark ' + (r.correct ? 'ok' : 'bad');
        mark.textContent = r.correct ? '✓' : '✗';
        row.appendChild(sent);
        row.appendChild(mark);
        list.appendChild(row);
      });
    }

    checkBtn.addEventListener('click', checkAnswer);
    nextBtn.addEventListener('click', goNext);
    restartBtn.addEventListener('click', startQuiz);

    startQuiz();
  }

  const gfSection = document.getElementById('gf');
  if (gfSection) initGapFill(gfSection);
</script>
