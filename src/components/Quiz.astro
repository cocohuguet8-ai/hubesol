---
const { quiz, next } = Astro.props;
---
{quiz && (
  <section class="quiz" id="quiz" aria-label="Practice quiz">
    <h2>✏️ Practice: {quiz.title}</h2>
    <p class="meta">Level {quiz.level} · {quiz.items.length} questions{quiz.items.some((it) => it.type === 'write') ? ` · ${quiz.items.filter((it) => it.type === 'write').length} to type` : ''} · instant feedback</p>
    {quiz.items.map((item, i) => (
      item.type === 'write' ? (
        <div class="q q-write" data-type="write" data-answers={JSON.stringify(item.answers)} data-expl={item.explanation} data-common={JSON.stringify(item.common || [])}>
          <p class="q-text">{i + 1}. <span class="q-kind">{item.kind || 'Type the answer'}</span> {item.question}</p>
          {item.hint && <p class="q-hint">{item.hint}</p>}
          <div class="write-row">
            <input type="text" class="write-input" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label={`Your answer to question ${i + 1}`} />
            <button type="button" class="practice-btn-primary write-check">Check</button>
          </div>
          <p class="expl" hidden></p>
        </div>
      ) : (
        <div class="q" data-answer={item.answer} data-expl={JSON.stringify(item.explanations)}>
          <p class="q-text">{i + 1}. {item.question}</p>
          <div class="opts">
            {item.options.map((opt, j) => (
              <button type="button" class="opt" data-idx={j}>{opt}</button>
            ))}
          </div>
          <p class="expl" hidden></p>
        </div>
      )
    ))}
    <p class="quiz-score" id="quiz-score"></p>
    <p class="quiz-actions" id="quiz-actions" hidden>
      <button type="button" class="practice-btn-primary" id="quiz-retry">Try again</button>
      {next && <a class="practice-btn-secondary" href={next.href}>Next lesson →</a>}
    </p>
  </section>
)}
<script>
  const quizEl = document.getElementById('quiz');
  if (quizEl) {
    let answered = 0;
    let correct = 0;
    const questions = Array.from(quizEl.querySelectorAll('.q'));
    const total = questions.length;
    const scoreEl = document.getElementById('quiz-score');
    const actionsEl = document.getElementById('quiz-actions');

    // Fisher–Yates shuffle of the option buttons (data-idx keeps the link to answer/explanations)
    const shuffleOptions = () => {
      questions.forEach((q) => {
        const box = q.querySelector('.opts');
        if (!box) return;
        const btns = Array.from(box.children);
        for (let i = btns.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [btns[i], btns[j]] = [btns[j], btns[i]];
        }
        btns.forEach((b) => box.appendChild(b));
      });
    };
    shuffleOptions();

    // Typed answers: ignore case, curly apostrophes, extra spaces, final punctuation,
    // and treat contractions as equal to their full forms (isn't = is not, I'm = I am).
    const norm = (s) => {
      let t = String(s).toLowerCase().replace(/[‘’`´]/g, "'").replace(/\s+/g, ' ').trim().replace(/[.!?]+$/, '').trim();
      t = t.replace(/\bwon't\b/g, 'will not').replace(/\bcan't\b/g, 'cannot').replace(/\bshan't\b/g, 'shall not')
        .replace(/n't\b/g, ' not').replace(/'m\b/g, ' am').replace(/'re\b/g, ' are').replace(/'ve\b/g, ' have').replace(/'ll\b/g, ' will')
        .replace(/\bcan not\b/g, 'cannot');
      return t;
    };

    const finish = () => {
      if (answered === total) {
        scoreEl.style.display = 'block';
        scoreEl.textContent = `Your score: ${correct}/${total}` + (correct === total ? ' — perfect! 🎉' : correct >= total * 0.7 ? ' — well done!' : ' — review the lesson above and try again.');
        actionsEl.hidden = false;
      }
    };

    const checkWrite = (q) => {
      const input = q.querySelector('.write-input');
      const btn = q.querySelector('.write-check');
      if (input.disabled) return;
      const raw = input.value;
      const explEl = q.querySelector('.expl');
      if (!norm(raw)) {
        explEl.hidden = false;
        explEl.classList.remove('good');
        explEl.classList.add('bad');
        explEl.textContent = 'Type your answer first — even a guess helps you learn.';
        input.focus();
        return;
      }
      const answers = JSON.parse(q.dataset.answers);
      const common = JSON.parse(q.dataset.common);
      const ok = answers.some((a) => norm(a) === norm(raw));
      input.disabled = true;
      btn.disabled = true;
      explEl.hidden = false;
      explEl.classList.remove('good', 'bad');
      if (ok) {
        correct++;
        input.classList.add('correct');
        explEl.classList.add('good');
        explEl.textContent = '✅ ' + q.dataset.expl;
      } else {
        input.classList.add('wrong');
        explEl.classList.add('bad');
        const hit = common.find((c) => norm(c.answer) === norm(raw));
        explEl.textContent = '❌ You wrote “' + raw.trim() + '”. ' + (hit ? hit.why + ' ' : '') + 'Correct answer: “' + answers[0] + '”. ' + q.dataset.expl;
      }
      answered++;
      finish();
    };

    quizEl.addEventListener('click', (e) => {
      const chk = e.target.closest('.write-check');
      if (chk) { checkWrite(chk.closest('.q')); return; }
      const btn = e.target.closest('.opt');
      if (!btn || btn.disabled) return;
      const q = btn.closest('.q');
      const answer = Number(q.dataset.answer);
      const chosen = Number(btn.dataset.idx);
      const expl = JSON.parse(q.dataset.expl);
      q.querySelectorAll('.opt').forEach((b) => {
        b.disabled = true;
        if (Number(b.dataset.idx) === answer) b.classList.add('correct');
      });
      const explEl = q.querySelector('.expl');
      explEl.hidden = false;
      if (chosen === answer) {
        correct++;
        explEl.classList.add('good');
        explEl.textContent = '✅ ' + expl[chosen];
      } else {
        btn.classList.add('wrong');
        explEl.classList.add('bad');
        explEl.textContent = '❌ ' + expl[chosen];
      }
      answered++;
      finish();
    });

    quizEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.classList && e.target.classList.contains('write-input')) {
        e.preventDefault();
        checkWrite(e.target.closest('.q'));
      }
    });

    document.getElementById('quiz-retry').addEventListener('click', () => {
      answered = 0;
      correct = 0;
      questions.forEach((q) => {
        q.querySelectorAll('.opt').forEach((b) => { b.disabled = false; b.classList.remove('correct', 'wrong'); });
        const input = q.querySelector('.write-input');
        if (input) { input.value = ''; input.disabled = false; input.classList.remove('correct', 'wrong'); }
        const chk = q.querySelector('.write-check');
        if (chk) chk.disabled = false;
        const explEl = q.querySelector('.expl');
        explEl.hidden = true;
        explEl.textContent = '';
        explEl.classList.remove('good', 'bad');
      });
      scoreEl.style.display = 'none';
      scoreEl.textContent = '';
      actionsEl.hidden = true;
      shuffleOptions();
      quizEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
