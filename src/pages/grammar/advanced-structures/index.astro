---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons', ({ data }) => !data.draft && data.hubSlug === 'advanced-structures');
const pub = new Set(lessons.map((l) => l.slug));
const isLive = (s) => pub.has(`advanced-structures/${s}`);

const rows = [
  { name: 'Cleft Sentences', slug: 'cleft-sentences', use: 'Putting the focus on one part of the sentence', ex: 'It was Maria who found the keys.' },
];

const related = [
  { name: 'Inversion in Conditionals', href: '/grammar/conditionals/inversion-in-conditionals/', note: 'Had I known…, Were I you… (formal)' },
];

const faq = [
  { q: 'What are advanced structures in English grammar?', a: 'Patterns that change the order or focus of a sentence for emphasis or style, such as cleft sentences and inversion. They are typical of C1–C2 English.' },
  { q: 'What is a cleft sentence?', a: 'A sentence split into two parts so that one part gets the focus: Maria found the keys → It was Maria who found the keys.' },
];

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Grammar', item: 'https://hubesol.com/grammar/' },
    { '@type': 'ListItem', position: 2, name: 'Advanced Structures', item: 'https://hubesol.com/grammar/advanced-structures/' },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Advanced English structures', itemListElement: rows.filter((r) => isLive(r.slug)).map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.name, url: `https://hubesol.com/grammar/advanced-structures/${r.slug}/` })) },
];
---
<Base
  title="Advanced Structures — C1–C2 English grammar | HubESOL"
  description="Advanced English structures for emphasis and style, starting with cleft sentences: what each one does, when to use it, with a lesson and quiz."
  jsonld={jsonld}
>
  <p class="crumbs"><a href="/grammar/">Grammar</a> › Advanced Structures</p>
  <h1>Advanced Structures</h1>
  <p class="meta">Patterns that give your English emphasis and style. What each one is for, with a lesson and quiz.</p>

  <div class="answer-box">
    <span class="label">Quick answer</span>
    <p class="answer-lead">Advanced structures change the order or focus of a sentence to emphasise what matters:</p>
    <ol class="answer-points">
      <li>Cleft sentences — It was Maria who found the keys.</li>
    </ol>
    <p class="answer-note">More structures will be added over time.</p>
  </div>

  <table>
    <tr><th>Structure</th><th>Use it for</th><th>Example</th></tr>
    {rows.map((r) => (
      <tr>
        <td>{isLive(r.slug) ? <a href={`/grammar/advanced-structures/${r.slug}/`}>{r.name}</a> : <span>{r.name} <span class="badge">soon</span></span>}</td>
        <td>{r.use}</td>
        <td>{r.ex}</td>
      </tr>
    ))}
  </table>

  <section>
    <h2>Related grammar points</h2>
    <ul>
      {related.map((r) => (<li><a href={r.href}>{r.name}</a> — {r.note}</li>))}
    </ul>
  </section>

  <h2>Frequently asked questions</h2>
  <div class="faq">
    {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </div>

  <section>
    <h2>Keep learning</h2>
    <ul>
      <li><a href="/grammar/conditionals/">All conditionals</a></li>
      <li><a href="/grammar/verb-tenses/">All 12 verb tenses</a></li>
    </ul>
  </section>
</Base>
