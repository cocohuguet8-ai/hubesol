  "gapFill": {
    "title": "Fill in the gaps",
    "subtitle": "Complete the passive version of each idea: is / are / was / were + past participle. Keep the same tense as the active. Twenty original sentences.",
    "questions": [
      {
        "use": "Present",
        "before": "They sell newspapers here. → Newspapers",
        "after": "here.",
        "hint": "(sell)",
        "answers": [
          "are sold"
        ],
        "display": "are sold",
        "explain": "Active present simple → passive: are + sold."
      },
      {
        "use": "Present",
        "before": "People speak Catalan in Andorra. → Catalan",
        "after": "in Andorra.",
        "hint": "(speak)",
        "answers": [
          "is spoken"
        ],
        "display": "is spoken",
        "explain": "Same tense (present): is + spoken."
      },
      {
        "use": "Present",
        "before": "The school cleans the classrooms every day. → The classrooms",
        "after": "every day.",
        "hint": "(clean)",
        "answers": [
          "are cleaned"
        ],
        "display": "are cleaned",
        "explain": "Plural new subject, present: are cleaned."
      },
      {
        "use": "Present",
        "before": "They don’t allow dogs. → Dogs",
        "after": ".",
        "hint": "(not allow)",
        "answers": [
          "aren’t allowed",
          "aren't allowed",
          "arent allowed",
          "are not allowed"
        ],
        "display": "aren’t allowed",
        "explain": "Negative present passive: aren’t + allowed."
      },
      {
        "use": "Past",
        "before": "Someone stole my bike. → My bike",
        "after": ".",
        "hint": "(steal)",
        "answers": [
          "was stolen"
        ],
        "display": "was stolen",
        "explain": "Active past simple → was + stolen; drop ‘someone’."
      },
      {
        "use": "Past",
        "before": "Gaudí designed Park Güell. → Park Güell",
