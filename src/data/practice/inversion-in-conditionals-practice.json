        "display": "would have said",
        "explain": "The result clause stays the same as a third conditional: would have said."
      },
      {
        "use": "Result",
        "before": "Were I you, I",
        "after": "immediately.",
        "hint": "(apologise)",
        "answers": [
          "would apologise",
          "’d apologise",
          "'d apologise",
          "d apologise"
        ],
        "display": "would apologise",
        "explain": "The result of an inverted second conditional: would + base verb."
      }
    ]
