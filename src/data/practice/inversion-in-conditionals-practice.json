      },
      {
        "use": "Should",
        "before": "",
        "after": "the alarm sound, leave the building at once.",
        "hint": "Should / Were / Had",
        "answers": [
          "Should"
        ],
        "display": "Should",
        "explain": "An instruction for a possible future event: Should + subject + base verb."
      },
      {
        "use": "Should",
        "before": "",
        "after": "you have any questions, do not hesitate to contact us.",
        "hint": "Should / Were / Had",
        "answers": [
          "Should"
        ],
        "display": "Should",
        "explain": "A formal letter phrase: Should you have… = If you have…"
      },
      {
        "use": "Should",
        "before": "Should you",
        "after": "further details, please call our office.",
