        "display": "require",
        "explain": "After inverted ‘should’ use the base verb: ‘require’, not ‘requires’."
      },
      {
        "use": "Should",
        "before": "Should the train",
        "after": "delayed, we will send you an email.",
        "hint": "(be)",
        "answers": [
          "be"
        ],
        "display": "be",
        "explain": "Base verb after ‘should’: be, not ‘is’."
      },
      {
