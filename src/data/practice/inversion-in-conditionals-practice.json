        "display": "not",
        "explain": "Should + subject + not + base verb: ‘Should you not receive’."
      },
      {
        "use": "Result",
        "before": "Had I seen you, I",
        "after": "hello.",
        "hint": "(say)",
        "answers": [
          "would have said"
