        "after": "more free time, I’d learn the guitar.",
        "hint": "(have)",
        "answers": [
          "had"
        ],
        "display": "had",
        "explain": "An imaginary present takes the past simple in the if-clause: have → had."
      },
      {
        "use": "Imaginary present",
        "before": "If we lived by the sea, we",
        "after": "every day.",
        "hint": "(swim)",
