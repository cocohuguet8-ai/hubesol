  "gapFill": {
    "title": "Fill in the gaps",
    "subtitle": "Type the missing part of the reported question: if / whether, the question word, or the verb in statement order with backshift. Twenty original sentences.",
    "questions": [
      {
        "use": "Yes/No",
        "before": "“Are you tired?” → She asked",
        "after": "I was tired.",
        "hint": "if / that",
        "answers": [
          "if",
          "whether"
        ],
        "display": "if",
        "explain": "A yes/no question is reported with ‘if’ or ‘whether’."
      },
      {
        "use": "Yes/No",
        "before": "“Do you like pizza?” → He asked if I",
        "after": "pizza.",
        "hint": "(like)",
        "answers": [
          "liked"
        ],
        "display": "liked",
        "explain": "No ‘do’ in reported questions; present simple moves back: liked."
      },
      {
        "use": "Yes/No",
        "before": "“Can you help me?” → She asked if I",
        "after": "help her.",
        "hint": "can / could",
        "answers": [
          "could"
        ],
        "display": "could",
        "explain": "‘Can’ moves back to ‘could’ after ‘asked’."
      },
      {
        "use": "Yes/No",
        "before": "“Have you finished?” → The teacher asked whether we",
        "after": ".",
        "hint": "(finish)",
        "answers": [
          "had finished"
        ],
        "display": "had finished",
        "explain": "Present perfect moves back to past perfect: had finished."
      },
      {
        "use": "Yes/No",
        "before": "“Will you come tomorrow?” → He asked if I",
        "after": "the next day.",
        "hint": "(come)",
        "answers": [
          "would come"
