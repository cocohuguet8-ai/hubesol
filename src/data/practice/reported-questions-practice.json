        "display": "asked",
        "explain": "Questions are reported with ‘ask’ (+ person)."
      },
      {
        "use": "Reporting verb",
        "before": "He wanted to",
        "after": "if the shop was open.",
        "hint": "know / ask",
        "answers": [
          "know"
        ],
        "display": "know",
        "explain": "Another reporting phrase for questions: wanted to know."
      },
      {
        "use": "Reporting verb",
        "before": "I",
        "after": "why she hadn’t called.",
        "hint": "wondered / asked to",
        "answers": [
          "wondered"
        ],
        "display": "wondered",
        "explain": "‘Wonder’ can report a question you ask yourself."
      },
      {
        "use": "Pronoun",
        "before": "“Is this your bag?” → She asked if it was",
        "after": "bag.",
        "hint": "(your)",
        "answers": [
          "my"
        ],
        "display": "my",
        "explain": "She was speaking to me, so ‘your’ becomes ‘my’."
      },
      {
        "use": "Whether",
        "before": "“Do you want tea or coffee?” → He asked",
        "after": "I wanted tea or coffee.",
        "hint": "whether / that",
        "answers": [
          "whether"
        ],
        "display": "whether",
        "explain": "‘Whether’ is common with a choice: tea or coffee."
      }
